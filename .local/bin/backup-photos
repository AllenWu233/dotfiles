#!/usr/bin/env bash
# @author Allen
# Unified photo backup script
# Usage: backup-photos.sh {phone|disk}

. "$HOME/.local/lib/message.sh"

# Backup entries: phone_relative_path|local_dir_name
# Both phone and disk backups read from this single list.
BACKUP_ENTRIES=(
    "Pictures/bili|bili"
    "Pictures/Outer-Wilds|Outer-Wilds"
    "Pictures/QQ|QQ"
    "Pictures/Twitter|Twitter"
    "Pictures/WeiXin|WeiXin"
    "Pictures/漫画|漫画"
    "Pictures/海虎武神|海虎武神"
    "Pictures/pixez-old|pixez-old"
    "Pictures/NSFW-pixiv|NSFW-pixiv"
    "Pictures/Screenshots|Screenshots"
    "Pictures/Deltarune|Deltarune"
    "Pictures/Undertale|Undertale"
    "Pictures/meme|meme"
    "DCIM/Camera|Camera"
    "Pictures/NSFW-Touhou|NSFW-Touhou"
    "Pictures/Touhou|Touhou"
    "DCIM/Screenshots|Screenshots"
)

# SSH configuration for Termux
SSH_USER="root"
SSH_HOST="192.168.1.12"
SSH_PORT="8022"
SSH_REMOTE_BASE="/data/data/com.termux/files/home/storage/shared"

# Local photo root and disk destination
LOCAL_PHOTO_DIR="$HOME/Pictures"
DEST_MOUNT_POINT="/run/media/Allen/42"
DEST_DIR="$DEST_MOUNT_POINT/Pictures"

check_dependencies() {
    local mode="$1"
    local req_cmds=()

    case "$mode" in
    phone) req_cmds=("rsync" "ssh") ;;
    disk) req_cmds=("rsync" "udiskie-mount") ;;
    esac

    for cmd in "${req_cmds[@]}"; do
        if ! command -v "$cmd" &>/dev/null; then
            echo_error "$cmd is not installed"
            exit 1
        fi
    done
}

backup_phone() {
    echo_title "Starting backup from phone to: $LOCAL_PHOTO_DIR"
    mkdir -p "$LOCAL_PHOTO_DIR"

    local total=${#BACKUP_ENTRIES[@]}
    local success_cnt=0
    local failed_cnt=0
    local skipped_cnt=0

    for entry in "${BACKUP_ENTRIES[@]}"; do
        local rel_path="${entry%%|*}"
        local name="${entry##*|}"
        local remote_path="${SSH_REMOTE_BASE}/${rel_path}"

        echo -e "$FG_GREEN\n\n-> Backing up: $remote_path$COLOR_RESET"

        if ! ssh -p "$SSH_PORT" "$SSH_USER@$SSH_HOST" "[ -d '$remote_path' ]"; then
            echo_warning "Remote path not found - skipping: $rel_path"
            ((skipped_cnt++))
            continue
        fi

        # Target is parent dir; rsync creates correct subdir automatically
        rsync -av --progress --ignore-existing \
            -e "ssh -p $SSH_PORT" \
            "${SSH_USER}@${SSH_HOST}:${remote_path}" \
            "$LOCAL_PHOTO_DIR"

        if [ $? -eq 0 ]; then
            echo_success "Backup completed: $name"
            ((success_cnt++))
        else
            echo_error "Backup failed: $name"
            ((failed_cnt++))
        fi
    done

    print_statistics "$total" "$success_cnt" "$failed_cnt" "$skipped_cnt"
}

backup_disk() {
    echo_title "Starting backup from $LOCAL_PHOTO_DIR to: $DEST_DIR"

    if ! mountpoint -q "$DEST_MOUNT_POINT"; then
        echo_info "Mounting $DEST_MOUNT_POINT ..."
        udiskie-mount "$DEST_MOUNT_POINT" || {
            echo_error "Failed to mount $DEST_MOUNT_POINT"
            exit 1
        }
    fi

    mkdir -p "$DEST_DIR"

    local total=0
    local success_cnt=0
    local failed_cnt=0
    local skipped_cnt=0
    local processed=()

    for entry in "${BACKUP_ENTRIES[@]}"; do
        local name="${entry##*|}"

        # skip if this local dir has already been processed
        local already=0
        for p in "${processed[@]}"; do
            if [[ "$p" == "$name" ]]; then
                already=1
                break
            fi
        done
        [[ $already -eq 1 ]] && continue

        processed+=("$name")
        local src="${LOCAL_PHOTO_DIR}/${name}"

        echo -e "$FG_GREEN\n\n-> Backing up: $src$COLOR_RESET"

        if [ ! -d "$src" ]; then
            echo_warning "Source path not found - skipping: $src"
            ((skipped_cnt++))
            continue
        fi

        # Use --no-perms --no-owner --no-group to avoid errors on non-Unix filesystems
        rsync -av --progress --ignore-existing \
            --no-perms --no-owner --no-group \
            --no-links \
            "$src" "$DEST_DIR"

        if [ $? -eq 0 ]; then
            echo_success "Backup completed: $name"
            ((success_cnt++))
        else
            echo_error "Backup failed: $name"
            ((failed_cnt++))
        fi

        ((total++))
    done

    print_statistics "$total" "$success_cnt" "$failed_cnt" "$skipped_cnt"
}

print_statistics() {
    local total="$1" success="$2" failed="$3" skipped="$4"

    echo -e "\n${STYLE_INFO}--- Backup Statistics ---${COLOR_RESET}"
    echo -e "${STYLE_INFO}Total directories:${COLOR_RESET} $total"
    echo -e "${STYLE_SUCCESS}Successful backups:${COLOR_RESET} $success"
    echo -e "${STYLE_ERROR}Failed backups:${COLOR_RESET} $failed"
    echo -e "${STYLE_WARNING}Skipped directories:${COLOR_RESET} $skipped\n"
}

usage() {
    echo "Usage: $0 {phone|disk}"
    echo "  phone    Backup photos from Termux SSH to local machine"
    echo "  disk     Backup photos from local machine to external disk"
}

main() {
    if [ $# -ne 1 ]; then
        usage
        exit 1
    fi

    local mode="$1"
    case "$mode" in
    phone | from-phone | ssh) mode="phone" ;;
    disk | to-disk | hdd) mode="disk" ;;
    *)
        usage
        exit 1
        ;;
    esac

    check_dependencies "$mode"

    if [ "$mode" == "phone" ]; then
        backup_phone
    else
        backup_disk
    fi

    echo_title "Backup process finished"
}

main "$@"
