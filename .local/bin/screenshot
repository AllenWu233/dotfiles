#!/bin/bash
# @author Allen
# @since 2025
# Take screenshot and copy to clipboard
# Usage: screenshot [full|area]

# Config
SAVE_DIR="$HOME/Pictures/Screenshots"
FILENAME="Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
FULL_PATH="$SAVE_DIR/$FILENAME"
REQUIRED_DEPS=("grim" "slurp" "notify-send" "wl-copy")

# Check command exists
exists() {
    type "$1" >/dev/null 2>/dev/null
    return $?
}

# Check dependencies
check_deps() {
    local missing=()
    for dep in "${REQUIRED_DEPS[@]}"; do
        exists "$dep" || missing+=("$dep")
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo "Error: Missing dependencies: ${missing[*]}"
        exit 1
    fi
}

full_screenshot() {
    if mkdir -p "$SAVE_DIR" && grim "$FULL_PATH"; then
        notify-send "Screenshot saved" "Fullscreen: $FILENAME" -i "$FULL_PATH"
        wl-copy <"$FULL_PATH"
    fi
    # if [ $? -eq 0 ]; then
    #     notify-send "Screenshot saved" "Fullscreen: $FILENAME" -i "$FULL_PATH"
    # else
    #     notify-send "Screenshot failed" "Cannot save fullscreen" -u critical
    # fi
}

area_screenshot() {
    if mkdir -p "$SAVE_DIR" && grim -g "$(slurp)" "$FULL_PATH"; then
        notify-send "Screenshot saved" "Area: $FILENAME" -i "$FULL_PATH"
        wl-copy <"$FULL_PATH"
    fi
    # if [ $? -eq 0 ]; then
    #     notify-send "Screenshot saved" "Area: $FILENAME" -i "$FULL_PATH"
    # else
    #     notify-send "Screenshot failed" "No area selected or save error" -u critical
    # fi
}

# Main logic
main() {
    check_deps
    case "$1" in
    area) area_screenshot ;;
    full | *) full_screenshot ;;
    esac
}

# Start
main "$@"
