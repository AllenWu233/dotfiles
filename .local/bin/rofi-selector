#!/usr/bin/env python3
"""
@title: rofi-selector
@desc: Control heart for some rofi scripts
@usage: rofi-selector
@deps: rofi, greenclip, dmenu-arch-wiki, autorandr
@date: 2026
@auth: Allen
"""

import os
import subprocess


# Define data structure for menu items
class Item:
    def __init__(self, key, label, cmd):
        self.key = key
        self.label = label
        self.cmd = cmd


HOME = os.getenv("HOME")

# Configuration list using Item objects
MENU_ITEMS = [
    Item(
        "c",
        "Clipboard",
        "clipcat-menu",
    ),
    Item("d", "Dotfiles", f"{HOME}/.local/bin/dmenu-dotfiles"),
    Item("e", "Emoji", "rofi -show emoji"),
    Item("w", "Arch Wiki (en)", f"{HOME}/.local/bin/dmenu-arch-wiki"),
    Item(
        "z",
        "Arch Wiki (zh-CN)",
        f"{HOME}/.local/bin/dmenu-arch-wiki zh",
    ),
    Item("m", "Monitor", f"{HOME}/.local/bin/dmenu-monitor"),
]

# Build rofi menu text and arguments
items = "".join(f"[{item.key}] {item.label}\n" for item in MENU_ITEMS)
rofi_cmd = ["rofi", "-dmenu", "-i", "-p", " Selection"]

for i, item in enumerate(MENU_ITEMS, start=1):
    rofi_cmd.extend([f"-kb-custom-{i}", item.key])

# Launch rofi
process = subprocess.run(rofi_cmd, input=items, text=True, capture_output=True)

code = process.returncode
choice = process.stdout.strip()

# Resolve target item
target_item = None
if 10 <= code <= 9 + len(MENU_ITEMS):
    target_item = MENU_ITEMS[code - 10]
elif code == 0 and choice:
    for item in MENU_ITEMS:
        if f"[{item.key}]" in choice:
            target_item = item
            break

# Execute matched command
if target_item:
    subprocess.run(target_item.cmd, shell=True)
