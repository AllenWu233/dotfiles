#!/bin/bash
# @author Allen
# @since 2026
# dmenu-power: A minimal power menu script

menu="[l] 󰌾 Lock screen
[o] 󰩈 Log out
[h] 󰋊 Hibernate
[r] 󰜉 Reboot
[p] 󰐥 Poweroff"

choice=$(echo "$menu" | rofi -dmenu -i -p " Power" \
    -kb-custom-1 l \
    -kb-custom-2 o \
    -kb-custom-3 h \
    -kb-custom-4 r \
    -kb-custom-5 p)
code=$?

case "$code:$choice" in
10:* | 0:*"Lock screen"*) exec loginctl lock-session ;;
11:* | 0:*"Log out"*) exec loginctl terminate-user "$USER" ;;
12:* | 0:*"Hibernate"*) exec systemctl hibernate ;;
13:* | 0:*"Reboot"*) exec systemctl reboot ;;
14:* | 0:*"Poweroff"*) exec systemctl poweroff ;;
esac
