#!/usr/bin/env bash
# @author Allen
# @since 2025
# Toggle mouse-button click hold for Wayland (ydotool)
# Usage: $0 [left|right]

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/hold_${1}_state"

systemctl --user is-active ydotool &>/dev/null || {
    notify-send -u critical "Sway" "ydotool not running. Use 'systemctl --user enable --now ydotool.service'"
    echo "ydotool not running. Use 'systemctl --user enable --now ydotool.service'"
    exit 1
}

case ${1} in
left)
    down=0x40
    up=0x80
    ;;
right)
    down=0x41
    up=0x81
    ;;
*) echo "Usage: $0 [left|right]" && exit 1 ;;
esac

if [[ -f $STATE_FILE ]]; then
    ydotool click "$up"
    rm "$STATE_FILE"
    notify-send "ydotool" "Left button click hold OFF"
else
    ydotool click "$down"
    touch "$STATE_FILE"
    notify-send "ydotool" "Right button click hold ON"
    while [[ -f $STATE_FILE ]]; do sleep 0.1; done
    ydotool click "$up"
fi
