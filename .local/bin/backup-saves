#!/usr/bin/env bash
# @author Allen
# @since 2025
# backs up multiple game saves (files or dirs) to given destinations
# usage: saves-backup

set -eu

# Source saves files
save_paths=(
    # "$HOME/.config/VintagestoryData/Saves/robinson crusoe.vcdbs"
    # "$HOME/.config/VintagestoryData/Saves/outerwilds.vcdbs"
    "$HOME/Games/射命丸文的寂静的故乡/G2Depart_v1.0.2/G2_depart/Saved/SaveGames"
)

# Target to storage backups
backup_paths=(
    # "$HOME/Games/VintageStory/saves/robinson-crusoe"
    # "$HOME/Games/VintageStory/saves/OuterWilds"
    "$HOME/Games/射命丸文的寂静的故乡/G2Depart_v1.0.2/G2_depart/Saved/SaveGames-backup"
)

[ ${#save_paths[@]} -eq ${#backup_paths[@]} ] || {
    echo "ERROR: path lists length mismatch" >&2
    exit 1
}

date=$(date +%Y-%m-%d_%H-%M-%S)

for i in "${!save_paths[@]}"; do
    src=${save_paths[i]}
    dest_dir=${backup_paths[i]}
    mkdir -p "$dest_dir"
    (
        cd "$(dirname "$src")" || exit
        tar -czf "$dest_dir/$date.tar.gz" "$(basename "$src")"
    )
    echo "Backup saved to: $dest_dir/$date.tar.gz"
done
