#!/bin/bash
# @title: ime-bridge
# @desc: Universal IME bridge for Wayland/X11. Captures text via YAD and pastes into the previously active window.
# @usage: Bind to a hotkey (e.g., Super+Z). The script shows a YAD entry dialog, then pastes the entered text.
# @deps: yad,
#        Wayland: wl-clipboard, wtype/ydotool
#        X11: xsel, xdotool
# @date: 2026-07-01
# @auth: Allen

# Detect environment and set tools
if [ -n "$WAYLAND_DISPLAY" ]; then
    # Wayland: use wl-clipboard
    COPY="wl-copy -n"
    GET_CLIP="wl-paste -n"
    # Prefer wtype over ydotool for reliability
    if command -v wtype >/dev/null; then
        PASTE_CMD="wtype -M ctrl v -m ctrl"
    else
        PASTE_CMD="ydotool key 29:1 47:1 47:0 29:0"
    fi
else
    # X11: use xsel
    COPY="xsel -bi"
    GET_CLIP="xsel -bo"
    PASTE_CMD="xdotool key ctrl+v"
fi

# Fetch current clipboard content for editing convenience
CURRENT_TEXT=$($GET_CLIP 2>/dev/null || echo "")

# Show YAD input dialog
INPUT_TEXT=$(yad --entry \
    --fixed \
    --title="Universal Input Bridge" \
    --text="Type text to paste:" \
    --entry-text="$CURRENT_TEXT" \
    --width=500 \
    --center \
    --on-top \
    --close-on-unfocus \
    --button="Paste:0")

# Process input and paste
if [ $? -eq 0 ] && [ -n "$INPUT_TEXT" ]; then
    # Write text to clipboard
    echo -n "$INPUT_TEXT" | $COPY
    # Perform paste
    $PASTE_CMD
fi
