#!/bin/bash
# @author Allen
# @since 2025
# Handle PipeWire microphone change and update wob bar.

ACTION=$1
SOURCE=@DEFAULT_SOURCE@
WOB_PIPE=/tmp/wobpipe

if [[ -z "$ACTION" || "$ACTION" == "-h" || "$ACTION" == "--help" ]]; then
    echo "Usage: $(basename "$0") <ACTION>"
    echo ""
    echo "Changes volume using 'wpctl' and updates the 'wob' overlay bar."
    echo ""
    echo "Actions:"
    echo "  up      # Increase volume by 5% and show level."
    echo "  down    # Decrease volume by 5% and show level."
    echo "  toggle  # Toggle mute status and show 0 (muted) or volume (unmuted)."
    exit 0
fi

case "$ACTION" in
up)
    # Increase volume
    wpctl set-volume "$SOURCE" 0.05+
    ;;
down)
    # Decrease volume
    wpctl set-volume "$SOURCE" 0.05-
    ;;
toggle)
    # Toggle mute status
    wpctl set-mute "$SOURCE" toggle
    ;;
*) ;;
esac

# Check mute status and get volume value
STATUS=$(wpctl get-volume "$SOURCE")
echo "$STATUS"

if echo "$STATUS" | grep -q 'MUTED'; then
    # If muted, send 0 (empty bar)
    echo 0 >"$WOB_PIPE"
else
    # Extract volume percentage and send
    VOLUME_PERCENT=$(echo "$STATUS" | awk -F: '{print $2}' | awk '{print int($1 * 100)}')
    echo "$VOLUME_PERCENT" >"$WOB_PIPE"
fi
