#!/usr/bin/env bash
# @title: dmenu-monitor
# @desc: Dynamic menu to switch monitor profiles managed by autorandr
# @usage: dmenu-monitor
# @deps: autorandr
# @date: 2026
# @auth: Allen

profiles="$(autorandr)"
current_profile=$(echo "$profiles" | awk '/\(current\)/ {print $1}')

# Select GUI menu backend based on session type
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    menu=(fuzzel --dmenu --mesg="Current: ${current_profile:-none}")
else
    menu=(rofi -dmenu -i -p "󰍹 " -mesg "Current: ${current_profile:-none}")
fi

# Filter out current profile and prompt for selection
selected_display=$(echo "$profiles" | awk '!/\(current\)/ && NF {print $1}' | sort | "${menu[@]}")

# Replace shell process to load selected profile
if [ -n "$selected_display" ]; then
    exec autorandr --load "$selected_display"
fi
