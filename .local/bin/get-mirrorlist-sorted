#!/usr/bin/env bash
# @author Allen
# @since 2025
# Get top 5 mirrorlist
# Usage: get-mirrorlist-sorted

if ! command -v rankmirrors &>/dev/null; then
    echo "Error: 'rankmirrors' command not found."
    echo "Install 'pacman-contrib': sudo pacman -S pacman-contrib"
    exit 1
fi

# if ! sudo mv -i /etc/pacman.d/mirrorlist{,.bak}; then
if ! sudo mv /etc/pacman.d/mirrorlist{,.bak}; then
    echo "Error: Failed to backup mirrorlist."
    exit 1
fi

tmp_mirror=$(mktemp)

echo "Fetching and ranking HTTPS mirrors for China..."
curl -s "https://archlinux.org/mirrorlist/?country=CN&protocol=https&use_mirror_status=on" |
    sed -e 's/^#Server/Server/' -e '/^#/d' |
    rankmirrors -n 5 - >"$tmp_mirror"
sudo cp "$tmp_mirror" /etc/pacman.d/mirrorlist
sudo chmod 644 /etc/pacman.d/mirrorlist

echo "New mirrorlist content:"
if command -v bat; then
    bat /etc/pacman.d/mirrorlist
else
    cat /etc/pacman.d/mirrorlist
fi
