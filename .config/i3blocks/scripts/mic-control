#!/bin/bash
# @author Allen
# @since 2025
# Generates microphone status for i3blocks.
# WARN: Dependencies: wpctl, bc

WOB_PIPE=/tmp/wobpipe
SOURCE=@DEFAULT_AUDIO_SOURCE@
SOURCE_STATUS=$(wpctl get-volume "$SOURCE")
STEP=0.01

# Catching i3blocks click
if [ -n "$BLOCK_BUTTON" ]; then
    case $BLOCK_BUTTON in
    1) LANGUAGE=zh_CN pavucontrol ;;
    3) LANGUAGE=zh_CN pavucontrol ;;
    4) wpctl set-volume "$SOURCE" "$STEP"+ >/dev/null 2>&1 ;;
    5) wpctl set-volume "$SOURCE" "$STEP"- >/dev/null 2>&1 ;;
    esac
fi

if echo "$SOURCE_STATUS" | grep -q 'MUTED'; then
    SOURCE_VOLUME="MUTE"
    SOURCE_ICON=" "
else
    SOURCE_VOLUME_FACTOR=$(echo "$SOURCE_STATUS" | grep -oE '[0-9]+\.[0-9]+')
    SOURCE_VOLUME=$(echo "$SOURCE_VOLUME_FACTOR * 100" | bc | awk '{print int($1)}')
    SOURCE_ICON=""
fi

# wob
if [ "$BLOCK_BUTTON" == 3 ] || [ "$BLOCK_BUTTON" == 4 ]; then
    if [ "$SOURCE_VOLUME" == "MUTE" ]; then
        echo "0" >"$WOB_PIPE"
    else
        echo "$SOURCE_VOLUME" >"$WOB_PIPE"
    fi
fi

if [ "$SOURCE_VOLUME" == "MUTE" ]; then
    echo "$SOURCE_ICON"
else
    echo "$SOURCE_ICON$SOURCE_VOLUME%"
fi

exit 0
