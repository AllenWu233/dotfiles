#!/usr/bin/env bash
# i3blocks: pending updates (official + AUR)
# deps: checkupdates, paru

CACHE="$HOME/.cache/i3blocks-scripts/paru-updates-cnt"
FLAG="$HOME/.cache/i3blocks-scripts/paru-updates-err"
AGE=3600

force=0
[[ $1 == "--force" ]] && force=1

# Initialize
mkdir -p "$(dirname "$CACHE")"
if [ ! -f "$CACHE" ] || [ ! -f "$FLAG" ]; then
    echo 0 >"$CACHE"
    echo 0 >"$FLAG"
    force=1
fi

read -r err <"$FLAG"

stale=$((($(stat -c %Y "$CACHE") + AGE) < $(date +%s)))

update_cnt() {
    if ! command -v paru &>/dev/null; then
        echo 1 >"$FLAG"
        return 1
    fi
    off=$(checkupdates 2>/dev/null | wc -l)
    aur=$(paru -Qua 2>/dev/null | wc -l)
    tot=$((off + aur))
    printf "%d\n" "$tot" >"$CACHE"
    echo 0 >"$FLAG"
}

((force || err || stale)) && update_cnt

read -r err <"$FLAG"
icon=$([ "$err" -eq 0 ] && echo "󰮯" || echo "⚠")
echo "[$icon $(cat "$CACHE")]"

# left/right click: upgrade interactively
[[ "$BLOCK_BUTTON" =~ ^1|3$ ]] && footclient -e paru -Syu && update_cnt

exit 0
