#!/usr/bin/env bash
# @author Allen
# @since 2025
# Print the number of pending updates (official repos + AUR) for i3blocks.
# Dependencies: paru

CACHE="$HOME/.cache/paru-updates.cnt"
FLAG="$HOME/.cache/paru-updates.err"
CACHE_AGE=3600 # seconds

# Initialize
[[ -f $CACHE ]] || echo 0 >"$CACHE"
[[ -f $FLAG ]] || echo 0 >"$FLAG"

read -r ERR <"$FLAG"

CACHE_MTIME=$(stat -c %Y "$CACHE")
NOW=$(date +%s)
CACHE_OUT_OF_DATE=$((CACHE_MTIME + CACHE_AGE < NOW))

# Refresh cache if older than CACHE_AGE
if ((ERR)) || ((CACHE_OUT_OF_DATE)); then
    # Fetch update count and write to cache
    if cnt=$(paru -Qu 2>/dev/null | awk 'NF' | wc -l); then
        printf "%d\n" "$cnt" >"$CACHE"
        echo 0 >"$FLAG"
    else
        echo 1 >"$FLAG"
    fi
fi

read -r ERR <"$FLAG"
if ((ERR)); then
    ICON="⚠"
else
    ICON="󰮯"
fi
echo "$ICON $(cat "$CACHE")"

[[ "$BLOCK_BUTTON" == 1 || "$BLOCK_BUTTON" == 3 ]] && footclient -e paru

exit 0
