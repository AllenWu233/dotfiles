#!/bin/bash

# Dependencies: ip, nmcli, grep, awk

# --- Configuration ---
# Wired interface name (e.g., eth0, enpXsX)
WIRED_IFACE="enp0s25"
# Wireless interface name (e.g., wlan0, wlpXsX)
WIRELESS_IFACE="wlan0"

# --- Functions ---

# Check Wi-Fi status using nmcli
check_wireless() {
    # Get active SSID
    SSID=$(nmcli -t -f active,ssid dev wifi | grep '^yes' | awk -F ':' '{print $2}')

    if [ ! -z "$SSID" ]; then
        # Get signal strength (0-100)
        SIGNAL=$(nmcli -t -f active,signal dev wifi | grep '^yes' | awk -F ':' '{print $2}' | tail -n 1)

        # Output format: [Icon] [SSID] [Signal%]
        echo " $SSID ($SIGNAL%)"
        return 0 # Wi-Fi connected
    fi
    return 1 # Wi-Fi not connected
}

# Check wired status
check_wired() {
    # Check if interface is UP and has an IP address
    if ip a show dev "$WIRED_IFACE" | grep -q "state UP" && ip a show dev "$WIRED_IFACE" | grep -q "inet "; then
        # Get IPv4 address
        IP=$(ip a show dev "$WIRED_IFACE" | grep -oP 'inet \K[\d.]+' | head -n 1)

        # Output format: [Icon] [IP Address]
        echo " $IP"
        return 0 # Wired connected
    fi
    return 1 # Wired not connected
}

# --- Main Logic ---

# 1. Check Wireless
if check_wireless; then
    exit 0
fi

# 2. Check Wired
if check_wired; then
    exit 0
fi

# 3. Neither connected
echo "Disconnected"
exit 0
