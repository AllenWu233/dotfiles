#!/bin/bash

# --- Configuration ---
INTERNAL_DISPLAY="eDP-1"

# Nerd Font Icons (Edit these based on your font)
ICON_ON="󰍹"  # Monitor Icon
ICON_OFF="󰶐" # Monitor Off Icon

# --- Status Check ---
if wlr-randr | grep -A 10 "$INTERNAL_DISPLAY" | grep -q "Enabled: yes"; then
    # Output for i3blocks (Full Text)
    echo "[$ICON_ON ]"
else
    # Output for i3blocks (Full Text)
    echo "[$ICON_OFF ]"
    echo ""
    echo "#777777"
fi
