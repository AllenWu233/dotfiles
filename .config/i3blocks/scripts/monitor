#!/bin/bash

# --- Configuration ---
INTERNAL_DISPLAY="eDP-1"

ICON_ON="󰍹"
ICON_OFF="󰶐"

# --- Logic ---

# Check for Wayland (wlr-randr)
if [[ -n "$WAYLAND_DISPLAY" ]]; then
    if wlr-randr | grep -A 10 "$INTERNAL_DISPLAY" | grep -q "Enabled: yes"; then
        STATUS="on"
    else
        STATUS="off"
    fi

# Check for Xorg (xrandr)
elif [[ -n "$DISPLAY" ]]; then
    if xrandr --query | grep "^$INTERNAL_DISPLAY connected" | grep -q "[0-9]\+x[0-9]\+"; then
        STATUS="on"
    else
        STATUS="off"
    fi
fi

# --- Output for i3blocks ---
if [[ "$STATUS" == "on" ]]; then
    echo "[$ICON_ON ]"
else
    echo "[$ICON_OFF ]"
    echo ""        # Short text for i3blocks
    echo "#777777" # Color for inactive state
fi
