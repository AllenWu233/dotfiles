#!/usr/bin/env bash
# Dependencies: nmcli

# Wired interface name (change it if yours differs)
WIRED_IFACE="enp52s0"

# Convert kB/s to human-readable dynamic units (KiB / MiB / GiB)
human_rate() {
    awk -v b="$1" '
    BEGIN {
        if (b == 0)              printf "0KiB/s"
        else if (b < 1048576)    printf "%.1fKiB/s", b/1024
        else if (b < 1073741824) printf "%.1fMiB/s", b/1048576
        else                     printf "%.1fGiB/s", b/1073741824
    }'
}

# Check link and IP
wired_status="$(ip a show dev "$WIRED_IFACE")"
if echo "$wired_status" | grep -q "state UP" && echo "$wired_status" | grep -q "inet "; then
    # Get upload and download speed
    rx1=$(cat "/sys/class/net/$WIRED_IFACE/statistics/rx_bytes")
    tx1=$(cat "/sys/class/net/$WIRED_IFACE/statistics/tx_bytes")
    sleep 1
    rx2=$(cat "/sys/class/net/$WIRED_IFACE/statistics/rx_bytes")
    tx2=$(cat "/sys/class/net/$WIRED_IFACE/statistics/tx_bytes")
    # Human-readable format
    rx_str=$(human_rate $((rx2 - rx1)))
    tx_str=$(human_rate $((tx2 - tx1)))

    ip=$(echo "$wired_status" | grep -oP 'inet \K[\d.]+' | head -n 1)

    # full text on first line, short text on second (i3blocks)
    echo "󰲝 $ip  $rx_str↓ $tx_str↑"
    echo "󰲝 "
else
    echo "󰲛 "
fi

# Left / right click opens connection editor
[[ "$BLOCK_BUTTON" == 1 || "$BLOCK_BUTTON" == 3 ]] && LANGUAGE=zh_CN nm-connection-editor

# Exit 33 tells i3blocks to use urgent color when link is down
ip link show "$WIRED_IFACE" | grep -q "state UP" || exit 33

exit 0
