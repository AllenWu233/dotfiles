#!/bin/env bash
# @author Allen
# @since 2025

# Import $city from dotfiles/private/wttr-city
. "$HOME/private/wttr-city"

CACHE_FILE="$HOME/.cache/wttr-weather"
CACHE_TTL=1800 # 30min
TIMEOUT=60

if [[ -f "$CACHE_FILE" && $(($(date +%s) - $(stat -c %Y "$CACHE_FILE"))) -lt $CACHE_TTL ]]; then
    cat "$CACHE_FILE"
    exit 0
fi

weather_raw=$(curl -s --max-time "$TIMEOUT" "wttr.in/$city?format=3")
if [ -f "$weather_raw" ]; then
    echo "$weather_raw" >"$CACHE_FILE"
    echo "$weather_raw"
else
    echo " "
fi

exit 0
