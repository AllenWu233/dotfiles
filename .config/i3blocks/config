# i3blocks configuration file
# @author Allen
# @since 2025
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=false
separator_block_width=5



[tomato]
command=scripts/tomato_clock
interval=1

[paru]
command=scripts/paru-check-updates
interval=600

# [weather]
# command=echo "[$(scripts/weather)] "
# interval=600

[notice]


[filesystem]


[network]
command=scripts/network
interval=1

[hardware]
command=scripts/hardware
interval=10

[monitor]
command=scripts/monitor
interval=once
signal=4


[light]
command=scripts/brightness-control
interval=once
signal=3

[volume]
command=scripts/volume-control
interval=once
signal=1

[mic]
command=scripts/mic-control
interval=once
signal=2

[battery]
command=scripts/battery
interval=10

# [bluetooth]
# command=scripts/bluetooth
# interval=10

[time]
command=scripts/clock
interval=1

[hibernate]
full_text="⏻  "
command=systemctl hibernate
