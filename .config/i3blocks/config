[weather]


[notice]


[update]


[filesystem]


[hardware]


[wireless-network]
command=echo "[$(scripts/wireless-network) "
interval=1

[wired-network]
command=echo "$(scripts/wired-network)] "
interval=1

[light]
command=echo "[$(scripts/brightness-control) "
interval=1

[volume]
command=echo "$(scripts/volume-control) "
interval=1

[mic]
command=echo "$(scripts/mic-control)] "
interval=1

[power_and_bluetooth]
command=echo "[$(scripts/battery) $(scripts/bluetooth)] "
interval=10

[time]
command=echo "[󰥔 $(LC_TIME=C date '+%Y-%m-%d %a %H:%M')] "
interval=1

[hibernate]
full_text="⏻  "
command=systemctl hibernate
