# i3blocks configuration file
# @author Allen
# @since 2025
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=false
separator_block_width=0

# Print click data
# [clickme]
# align=center
# full_text=[Click me!]
# min_width=Button=? x=? y=?
# command=echo "[Button=$button x=$x y=$y] "


[weather]


[notice]


[update]


[filesystem]


[hardware]


[network]

[light]
# 💡 设置一个信号，通常是 SIGUSR1 (10) 或 SIGUSR2 (12)，这里我们用 10
signal=10 
# command=echo "[$(scripts/brightness) " # 原来的配置
command=scripts/brightness-control

interval=1
[volume]
command=echo "$(scripts/volume) "
interval=1

[mic]
command=echo "$(scripts/mic)] "
interval=1

# [light_and_volume]
# command=echo "[$(scripts/brightness) $(scripts/volume) $(scripts/mic)]"
# interval=1

[power_and_bluetooth]


[time]
command=echo "[󰥔 $(LC_TIME=C date '+%Y-%m-%d %a %H:%M')] "
interval=1

[hibernate]
full_text="⏻  "
command=systemctl hibernate
